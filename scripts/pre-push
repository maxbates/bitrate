#!/usr/bin/env bash
# Local pre-push hook (spec §8): a commit that reddens the gate does not
# land. Install with:  bash scripts/install-hooks.sh
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: go vet + tests"
go vet ./...
go test ./...

# The ship gate. It stopped running here when the ZIP was dropped (spec §8) and
# was repointed on 2026-07-27: it now copies a clean tree, runs `bash run.sh`
# exactly as the README instructs, and drives a full headless scored run —
# asserting the results card, server/reference score agreement, and zero
# non-localhost requests. That last assertion is the ONLY runtime enforcement of
# the no-external-requests property, so it is wired back in here rather than
# left to CI alone.
#
# It takes ~90 s (a full 60 s scored run plus startup). SKIP_GATE=1 skips it.
if [[ -n "${SKIP_GATE:-}" ]]; then
  echo "pre-push: ship gate SKIPPED (SKIP_GATE set)"
  exit 0
fi

VENV_PY="$PWD/lab/.venv/bin/python"
if [[ ! -x "$VENV_PY" ]]; then
  echo "pre-push: no lab/.venv — skipping the ship gate (CI still runs it)."
  echo "          set it up with: python3 -m venv lab/.venv &&"
  echo "          lab/.venv/bin/pip install -r lab/requirements.txt"
  exit 0
fi

echo "pre-push: ship gate (~90 s; SKIP_GATE=1 to skip)"
(cd lab && "$VENV_PY" ship_gate.py)
