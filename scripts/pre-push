#!/usr/bin/env bash
# Local pre-push hook (spec §8): a commit that reddens the gate does not
# land. Install with:  bash scripts/install-hooks.sh
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: go vet + tests"
go vet ./...
go test ./...

# The ship gate used to run here: it unzipped dist/bitrate.zip and drove a
# headless scored run to prove the grader's offline path worked. There is no ZIP
# any more (spec §8 — the submission is the deployed site plus the public repo),
# so the gate has nothing to unzip and is not invoked. `lab/ship_gate.py` is kept
# on disk because most of it — drive a real scored run headlessly, assert the
# results card, assert the server and reference scores agree, assert zero
# non-localhost requests — is still exactly what we want to assert against a
# running server rather than a bundle. Repointing it at a plain `run.sh` is the
# open task; until then the checks above are what gates a push.
#
# SKIP_GATE is still honoured so existing muscle memory and scripts don't break.
